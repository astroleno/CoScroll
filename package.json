{
  "name": "coscroll",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "tracks:prepare": "node deploy/prepare-track.mjs",
    "tracks:check": "node deploy/prepare-track.mjs --check",
    "prebuild": "npm run tracks:check",
    "models:prepare": "node deploy/prepare-models.mjs",
    "models:check": "node deploy/prepare-models.mjs --check",
    "release:package": "node deploy/package-release.mjs",
    "release:preview": "node deploy/preview-release.mjs",
    "release:verify": "node deploy/verify-release.mjs",
    "release:plan": "node deploy/stage-origin.mjs",
    "test:deployment": "node --test test/deploy/*.test.mjs",
    "test:runtime": "node --test test/runtime/*.test.mjs",
    "test:visual": "node test/runtime/ego-transmission-regression.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.100.0",
    "@react-three/fiber": "^8.16.0",
    "@react-three/postprocessing": "^2.19.1",
    "@tanstack/react-query": "^5.15.0",
    "framer-motion": "^10.18.0",
    "next": "^14.0.4",
    "ogl": "1.0.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.0",
    "three-stdlib": "^2.36.0",
    "tone": "^14.7.77",
    "troika-three-text": "^0.52.4",
    "zod": "^4.1.12",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.8.9",
    "@types/react": "^18.2.33",
    "@types/react-dom": "^18.2.14",
    "@types/three": "^0.158.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.52.0",
    "eslint-config-next": "14.0.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2"
  }
